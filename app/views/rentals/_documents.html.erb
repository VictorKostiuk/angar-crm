<%# locals: (rental:) %>
<%# The renter's ID — several per hire, click to enlarge. A client from the
    base shows what is kept on the client (D67) and then anything taken on
    this hire before that; a renter outside the base, this hire's own. Same
    thumbnail size, inline "+" batch upload and admin/owner-only delete as
    rentals/_bike_photos. %>
<% documents = (rental.client ? rental.client.documents.map { |d| [ d, client_document_path(rental.client, d.id) ] } : []) +
               rental.documents.map { |d| [ d, rental_document_path(rental, d.id) ] } %>
<div class="flex flex-wrap items-center gap-1" data-controller="lightbox">
  <% documents.each do |document, delete_path| %>
    <span class="relative group">
      <%= image_tag document.variant(resize_to_limit: [ 80, 80 ]),
            data: { action: "click->lightbox#open",
                    full_src: url_for(document.variant(resize_to_limit: [ 1600, 1600 ])),
                    full_alt: "Документ — #{rental.renter}" },
            class: "w-10 h-10 rounded border border-gray-200 object-cover cursor-zoom-in" %>
      <% if Current.user.admin? || Current.user.owner? %>
        <%= button_to "×", delete_path, method: :delete,
              form_class: "absolute -top-1 -right-1", data: { turbo_confirm: "Видалити документ?" },
              class: "w-4 h-4 rounded-full bg-gray-900/70 text-white text-[10px] leading-none cursor-pointer" %>
      <% end %>
    </span>
  <% end %>

  <%# Every role can add: the mechanic who hands the bike over is the one
      holding the phone, and a hire issued without documents has to be fixable. %>
  <%= form_with url: rental_documents_path(rental), multipart: true, class: "contents", data: { controller: "autosubmit" } do %>
    <label class="w-10 h-10 flex items-center justify-center rounded border border-dashed border-gray-300 text-gray-400 text-lg cursor-pointer hover:bg-gray-50"
           title="Додати документ">
      +
      <%= file_field_tag "documents[]", multiple: true, accept: "image/*", class: "hidden",
            data: { action: "change->autosubmit#submit" } %>
    </label>
  <% end %>

  <dialog data-lightbox-target="dialog" data-action="click->lightbox#closeOnBackdrop"
          class="max-w-[90vw] max-h-[90vh] rounded-xl p-0 m-auto bg-transparent backdrop:bg-gray-900/80">
    <img data-lightbox-target="image" class="max-w-[90vw] max-h-[90vh] rounded-xl object-contain" alt="">
    <button type="button" data-action="lightbox#close" aria-label="Закрити"
            class="absolute top-2 right-2 w-8 h-8 rounded-full bg-gray-900/70 text-white text-lg leading-none cursor-pointer">&times;</button>
  </dialog>
</div>
