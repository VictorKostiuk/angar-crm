<%# locals: (order_work:) %>
<%# A <form> is not a legal child of <tr>: the HTML5 parser inserts it empty and
    leaves the inputs outside it, so requestSubmit() posted an empty body and
    quantity/price edits silently did nothing. One form per cell is valid markup
    — and only the field actually changed gets sent, so the other can't be
    overwritten with a stale value. %>
<tr class="hover:bg-gray-50">
  <td class="px-4 py-2 text-gray-900"><%= order_work.name %></td>
  <td class="px-4 py-2 text-gray-600">
    <% if order_work.order.editable? %>
      <%= form_with model: [ order_work.order, order_work ], method: :patch,
            data: { controller: "autosubmit" }, class: "contents" do |f| %>
        <%= f.number_field :quantity, step: "any", min: "0.01",
              data: { action: "change->autosubmit#submit" },
              class: "w-16 rounded-md border border-gray-300 px-2 py-1 text-sm" %>
      <% end %>
    <% else %>
      <%= number_with_precision(order_work.quantity, precision: 2, strip_insignificant_zeros: true) %>
    <% end %>
  </td>
  <td class="px-4 py-2 text-gray-600">
    <% if order_work.order.editable? %>
      <%= form_with model: [ order_work.order, order_work ], method: :patch,
            data: { controller: "autosubmit" }, class: "contents" do |f| %>
        <%= f.number_field :price, step: "0.01", min: 0,
              data: { action: "change->autosubmit#submit" },
              class: "w-20 rounded-md border border-gray-300 px-2 py-1 text-sm" %>
      <% end %>
    <% else %>
      <%= money(order_work.price) %>
    <% end %>
  </td>
  <td class="px-4 py-2 text-gray-900 font-medium"><%= money(order_work.total) %></td>
  <td class="px-4 py-2 text-right">
    <% if order_work.order.editable? %>
      <%= button_to "✕", order_order_work_path(order_work.order, order_work), method: :delete,
            class: "text-gray-400 hover:text-red-600 bg-transparent cursor-pointer" %>
    <% end %>
  </td>
</tr>
