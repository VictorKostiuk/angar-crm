<% content_for :title, t("nav.orders") %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("nav.orders") %></h1>
  <%= link_to "+ Нове замовлення", new_order_path, class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
</div>

<%= filter_frame "orders_list" do %>
  <%= form_with url: orders_path, method: :get, data: { turbo_frame: "orders_list" },
        class: "bg-white border border-gray-200 rounded-xl p-4 mb-4" do %>
    <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Пошук</label>
        <%= text_field_tag :q, params[:q], placeholder: "№, клієнт, телефон, велосипед", class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Статус</label>
        <%= select_tag :status, options_for_select([ [ "Усі статуси", "" ], [ "Архів (закриті + скасовані)", "archive" ] ] +
                               Order.statuses.keys.map { |s| [ t("statuses.order.#{s}"), s ] }, params[:status]),
              class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Оплата</label>
        <%= select_tag :payment_status, options_for_select([ [ "Усі", "" ] ] + Order.payment_statuses.keys.map { |s| [ t("statuses.payment.#{s}"), s ] }, params[:payment_status]),
              class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Механік</label>
        <%= select_tag :mechanic_id, options_for_select([ [ "Усі механіки", "" ] ] + @mechanics.map { |m| [ m.name, m.id ] }, params[:mechanic_id]),
              class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Прийнято від</label>
        <%= date_field_tag :from, params[:from], class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Прийнято до</label>
        <%= date_field_tag :to, params[:to], class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      </div>
    </div>

    <div class="flex items-center justify-between mt-3">
      <%= submit_tag "Застосувати", class: "rounded-md bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
      <%= link_to "Скинути фільтри", orders_path, data: { turbo_frame: "orders_list" }, class: "text-sm text-brand-700 hover:underline" %>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">№</th>
          <th class="px-4 py-3 font-medium">Дата прийому</th>
          <th class="px-4 py-3 font-medium">Клієнт</th>
          <th class="px-4 py-3 font-medium">Велосипед</th>
          <th class="px-4 py-3 font-medium">Механік</th>
          <th class="px-4 py-3 font-medium">Статус</th>
          <th class="px-4 py-3 font-medium">Оплата</th>
          <th class="px-4 py-3 font-medium">Сума</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <%= link_to order_number(order), order, class: "font-medium text-brand-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= order.accepted_at.strftime("%d.%m.%Y %H:%M") %></td>
            <td class="px-4 py-3">
              <%= link_to order.client, class: "block hover:text-brand-600" do %>
                <span class="block text-gray-900"><%= order.client.name %></span>
                <span class="block text-gray-500 text-xs"><%= order.client.formatted_phone %></span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%= link_to order.bike.name, order.bike, class: "text-gray-600 hover:text-brand-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-600">
              <% if order.mechanic %>
                <%= link_to order.mechanic.name, mechanic_path(order.mechanic), class: "hover:text-brand-600 hover:underline" %>
              <% else %>—<% end %>
            </td>
            <td class="px-4 py-3"><%= render "shared/status_badge", order: order %></td>
            <td class="px-4 py-3"><%= render "shared/payment_badge", order: order %></td>
            <td class="px-4 py-3 text-gray-900 font-medium"><%= order.total.positive? ? money(order.total) : "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "›", order, class: "text-gray-400 hover:text-brand-600" %>
            </td>
          </tr>
        <% end %>

        <% if @orders.none? %>
          <tr>
            <td colspan="9" class="px-4 py-10 text-center text-gray-400">Замовлень не знайдено</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", page: params[:page], per_page: ApplicationRecord::PER_PAGE, total_count: @total_count, frame: "orders_list" %>
<% end %>
