<%# locals: (order:) %>
<div class="flex items-center gap-1">
  <%# Only at «Очікує видачі»: the message says the bike is ready, so it has no
      meaning before the mechanic has said so. Teal matches the status badge. %>
  <% if order.waiting_pickup? %>
    <%= link_to order_ready_message_path(order), data: { turbo_frame: "modal" }, title: "Повідомлення клієнту", "aria-label": "Повідомлення клієнту",
          class: "p-2.5 rounded-md text-teal-600 hover:bg-teal-50" do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 5H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h4v4l5-4h7a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1Z" />
      </svg>
    <% end %>
  <% end %>

  <%# Only at «Очікує погодження»: the recommended works and their estimate,
      for the client to agree to. Amber matches that status's badge. %>
  <% if order.waiting_approval? %>
    <%= link_to order_approval_message_path(order), data: { turbo_frame: "modal" }, title: "Повідомлення для погодження", "aria-label": "Повідомлення для погодження",
          class: "p-2.5 rounded-md text-amber-600 hover:bg-amber-50" do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 5H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h4v4l5-4h7a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1Z" />
        <path d="M12 8.5v3M12 14h.01" />
      </svg>
    <% end %>
  <% end %>

  <% if order.open_status? %>
    <%= link_to edit_order_status_path(order), data: { turbo_frame: "modal" }, title: "Змінити статус", "aria-label": "Змінити статус",
          class: "p-2.5 rounded-md text-brand-600 hover:bg-brand-50" do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
      </svg>
    <% end %>

    <%= link_to edit_order_closure_path(order), data: { turbo_frame: "modal" }, title: "Закрити замовлення", "aria-label": "Закрити замовлення",
          class: "p-2.5 rounded-md text-green-600 hover:bg-green-50" do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M8 12l3 3 5-6" />
      </svg>
    <% end %>

    <%= link_to edit_order_cancellation_path(order), data: { turbo_frame: "modal" }, title: "Скасувати", "aria-label": "Скасувати",
          class: "p-2.5 rounded-md text-red-600 hover:bg-red-50" do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M9.5 9.5l5 5M14.5 9.5l-5 5" />
      </svg>
    <% end %>
  <% end %>
</div>
