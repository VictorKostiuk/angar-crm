<%# locals: (order:, message:, title:, send_path: nil, sent_at: nil, error: nil, note: nil) %>
<%# The copy-out modal shared by the ready-for-pickup and the approval
    messages: the text in a readonly textarea plus a Копіювати button, with the
    client's phone and its call / Telegram links right above it.

    send_path adds «Надіслати в Telegram» — the same text through the bot
    (D64); sent_at says when it last went, error why the last try did not,
    and note explains the button's absence. %>
<%= render "shared/modal_header", title: title %>

<div data-controller="clipboard" data-clipboard-copied-label-value="Скопійовано">
  <div class="p-6 space-y-3">
    <% if error %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= error %></div>
    <% end %>

    <p class="text-sm text-gray-500">
      <%= order.client.name %> ·
      <%= render "shared/phone_actions", phone: order.client.phone %>
    </p>

    <%# readonly, not disabled: the text has to stay selectable so the message
        can still be copied by hand where the Clipboard API is unavailable. %>
    <textarea readonly data-clipboard-target="source" rows="<%= message.lines.count.clamp(8, 18) %>"
              class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-brand-600"><%= message %></textarea>

    <% if sent_at %>
      <p class="text-xs text-green-700">Надіслано в Telegram <%= l sent_at, format: "%d.%m о %H:%M" %>.</p>
    <% elsif note %>
      <p class="text-xs text-gray-500"><%= note %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.close") %></button>
    <% if send_path %>
      <%= button_to (sent_at ? "Надіслати ще раз" : "Надіслати в Telegram"), send_path, method: :post, form_class: "contents",
            data: { turbo_submits_with: "Надсилаю…" },
            class: "rounded-md border border-sky-600 text-sky-700 hover:bg-sky-50 text-sm font-medium px-4 py-2 cursor-pointer" %>
    <% end %>
    <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer">Копіювати</button>
  </div>
</div>
