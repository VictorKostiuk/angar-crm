<% content_for :title, "Рахунок — #{order_number(@order)}" %>

<%= render "shared/print_header" %>

<h1 class="text-xl font-bold mb-1">Рахунок</h1>
<p class="text-sm text-gray-500 mb-6"><%= order_number(@order) %> · <%= @order.client.name %> · <%= @order.bike.name %></p>

<% if @order.order_works.any? %>
  <table class="w-full text-sm mb-4">
    <thead>
      <tr class="border-b border-gray-300 text-left text-gray-500">
        <th class="py-2">Робота</th>
        <th class="py-2">К-сть</th>
        <th class="py-2">Ціна</th>
        <th class="py-2 text-right">Сума</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_works.order(:position).each do |work| %>
        <tr class="border-b border-gray-100">
          <td class="py-1.5"><%= work.name %></td>
          <td class="py-1.5"><%= work.quantity %></td>
          <td class="py-1.5"><%= money(work.price) %></td>
          <td class="py-1.5 text-right"><%= money(work.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @order.order_parts.any? %>
  <table class="w-full text-sm mb-6">
    <thead>
      <tr class="border-b border-gray-300 text-left text-gray-500">
        <th class="py-2">Деталь / матеріал</th>
        <th class="py-2">К-сть</th>
        <th class="py-2">Ціна</th>
        <th class="py-2 text-right">Сума</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_parts.order(:position).each do |part| %>
        <tr class="border-b border-gray-100">
          <td class="py-1.5"><%= part.name %></td>
          <td class="py-1.5"><%= part.quantity %></td>
          <td class="py-1.5"><%= money(part.price) %></td>
          <td class="py-1.5 text-right"><%= money(part.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<div class="text-right text-sm space-y-1 mb-8">
  <p>Роботи: <%= money(@order.works_total) %></p>
  <p>Деталі / матеріали: <%= money(@order.parts_total) %></p>
  <% if @order.discount.positive? %>
    <p>Знижка: −<%= money(@order.discount) %></p>
  <% end %>
  <p class="text-lg font-bold">Разом: <%= money(@order.total) %></p>
</div>

<% if @order.paid? %>
  <p class="text-sm text-gray-500">
    Оплачено: <%= t("payment_methods.#{@order.payment_method}") %><% if @order.receipt_number.present? %>, чек №<%= @order.receipt_number %><% end %>, <%= @order.paid_at.strftime("%d.%m.%Y %H:%M") %>
  </p>
<% else %>
  <p class="text-sm text-gray-500">Не оплачено</p>
<% end %>
