<% content_for :title, order_number(@order) %>

<div class="mb-4">
  <%= link_to "← Назад", :back, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div id="order_header" class="bg-white border border-gray-200 rounded-xl p-5 mb-6 flex flex-col sm:flex-row sm:items-start justify-between gap-3">
  <%= render "orders/header", order: @order %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="bg-white border border-gray-200 rounded-xl p-5 space-y-4 h-fit">
    <div>
      <p class="text-xs text-gray-500">Прийнято</p>
      <p class="text-sm text-gray-900"><%= @order.accepted_at.strftime("%d.%m.%Y %H:%M") %></p>
    </div>
    <div>
      <p class="text-xs text-gray-500">Прийняв</p>
      <p class="text-sm text-gray-900"><%= @order.accepted_by.name %></p>
    </div>
    <div>
      <p class="text-xs text-gray-500 mb-1">Механік</p>
      <%= form_with model: @order, class: "contents", data: { controller: "autosubmit" } do |f| %>
        <%= f.collection_select :mechanic_id, @mechanics, :id, :name, { include_blank: "Не призначено" },
              data: { action: "change->autosubmit#submit" },
              class: "block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <% end %>
    </div>
    <div>
      <p class="text-xs text-gray-500 mb-1">Знижка</p>
      <%= form_with model: @order, class: "contents",
            data: { controller: "discount-picker", discount_picker_subtotal_value: (@order.works_total + @order.parts_total) } do |f| %>
        <select data-discount-picker-target="select" data-action="change->discount-picker#apply"
                class="block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm">
          <option value="">Без знижки</option>
          <% @discounts.each do |discount| %>
            <option value="<%= discount.id %>" data-kind="<%= discount.kind %>" data-value="<%= discount.value %>">
              <%= discount.name %> (<%= discount.percentage? ? "#{discount.value.to_i}%" : money(discount.value) %>)
            </option>
          <% end %>
        </select>
        <%= f.hidden_field :discount, data: { discount_picker_target: "amount" } %>
      <% end %>
    </div>
    <% if @order.problem.present? %>
      <div>
        <p class="text-xs text-gray-500">Проблема</p>
        <p class="text-sm text-gray-900 whitespace-pre-line"><%= @order.problem %></p>
      </div>
    <% end %>
    <% if @order.comment.present? %>
      <div>
        <p class="text-xs text-gray-500">Коментар</p>
        <p class="text-sm text-gray-900 whitespace-pre-line"><%= @order.comment %></p>
      </div>
    <% end %>

    <div>
      <p class="text-xs text-gray-500 mb-1">Фото</p>
      <% if @order.photos.attached? %>
        <div class="grid grid-cols-3 gap-2 mb-2">
          <% @order.photos.each do |photo| %>
            <div class="relative group">
              <%= image_tag photo.variant(resize_to_limit: [ 150, 150 ]), class: "rounded-md border border-gray-200 aspect-square object-cover w-full" %>
              <%= button_to "×", order_photo_path(@order, photo), method: :delete,
                    data: { turbo_confirm: "Видалити фото?" },
                    class: "absolute top-1 right-1 w-5 h-5 rounded-full bg-gray-900/70 text-white text-xs leading-none cursor-pointer" %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= form_with url: order_photos_path(@order), multipart: true, class: "flex items-center gap-2" do %>
        <%= file_field_tag "photos[]", multiple: true, accept: "image/*",
              class: "block w-full text-xs text-gray-700 file:mr-2 file:rounded-md file:border-0 file:bg-gray-100 file:px-2 file:py-1 file:text-xs file:font-medium hover:file:bg-gray-200" %>
        <%= submit_tag "Додати", class: "shrink-0 rounded-md border border-gray-300 text-xs font-medium px-3 py-1.5 hover:bg-gray-50 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 class="font-bold text-gray-900">Роботи</h2>
        <%= link_to "+ Додати роботу", new_order_order_work_path(@order), data: { turbo_frame: "modal" },
              class: "rounded-md border border-gray-300 text-sm font-medium px-3 py-1.5 hover:bg-gray-50" %>
      </div>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-gray-500">
          <tr>
            <th class="px-4 py-2 font-medium">Робота</th>
            <th class="px-4 py-2 font-medium">К-сть</th>
            <th class="px-4 py-2 font-medium">Ціна</th>
            <th class="px-4 py-2 font-medium">Сума</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody id="order_works_rows" class="divide-y divide-gray-100">
          <%= render "orders/order_work_rows", order: @order %>
        </tbody>
      </table>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 class="font-bold text-gray-900">Деталі / матеріали</h2>
        <%= link_to "+ Додати деталь / матеріал", new_order_order_part_path(@order), data: { turbo_frame: "modal" },
              class: "rounded-md border border-gray-300 text-sm font-medium px-3 py-1.5 hover:bg-gray-50" %>
      </div>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-gray-500">
          <tr>
            <th class="px-4 py-2 font-medium">Деталь / матеріал</th>
            <th class="px-4 py-2 font-medium">К-сть</th>
            <th class="px-4 py-2 font-medium">Ціна</th>
            <th class="px-4 py-2 font-medium">Сума</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody id="order_parts_rows" class="divide-y divide-gray-100">
          <%= render "orders/order_part_rows", order: @order %>
        </tbody>
      </table>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5" id="order_totals">
      <%= render "orders/totals_panel", order: @order %>
    </div>

    <div id="order_status_timeline">
      <%= render "orders/status_timeline", status_changes: @order_status_changes %>
    </div>
  </div>
</div>
