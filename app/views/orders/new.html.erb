<% content_for :title, "Нове замовлення" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-4">
    <%= link_to "← До замовлень", orders_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-6">Нове замовлення</h1>

  <% if @order.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 mb-4">
      <% @order.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: orders_path, class: "space-y-6", multipart: true do %>
    <%# Sections 1 and 2 share a frame — picking a client re-renders both, since
        the bike choices depend on them — but each still gets its own card. %>
    <%= turbo_frame_tag "client_and_bike", class: "block space-y-6" do %>
      <%= render "client_and_bike_fields", client: @client, order: @order %>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">3. Опис проблеми</h2>
      <%= text_area_tag "problem", @order.problem,
            placeholder: "Наприклад: погано перемикає, скрипить каретка, підготувати велосипед до поїздки",
            rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">4. Коментар</h2>
      <%= text_area_tag "comment", @order.comment,
            placeholder: "Тут можна вказати всі додаткові деталі: побажання клієнта, особливості, бажану дату готовності тощо",
            rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">5. Прийом у роботу</h2>
      <label class="block text-sm font-medium text-gray-700 mb-1">Прийняв</label>
      <%= select_tag "accepted_by_id", options_from_collection_for_select(@mechanics, :id, :name, Current.user.id),
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">6. Фото (необов'язково)</h2>
      <%= file_field_tag "photos[]", multiple: true, accept: "image/*",
            class: "block w-full text-sm text-gray-700 file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-3 file:py-1.5 file:text-sm file:font-medium hover:file:bg-gray-200" %>
      <p class="mt-1 text-xs text-gray-400">Стан велосипеда під час прийому. Велосипед із бази вже має фото — вони підтягнуться в замовлення, тож фотографуйте, лише якщо стан змінився.</p>
    </div>

    <div class="flex flex-wrap justify-end gap-2">
      <%= link_to t("actions.cancel"), root_path, class: "rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
      <%= submit_tag "Прийняти велосипед", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-6 py-2 cursor-pointer" %>
    </div>
  <% end %>
</div>
