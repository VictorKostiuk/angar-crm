<%# status_in_database: after a failed submit @order.status already reads
    "cancelled" in memory, and the modal must still describe a booking. %>
<% booked = @order.status_in_database == "booked" %>
<%= render "shared/modal_header", title: booked ? "Скасувати запис" : "Скасувати замовлення" %>

<%= form_with url: order_cancellation_path(@order), method: :patch, class: "contents" do %>
  <div class="p-6 space-y-4">
    <% if @order.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @order.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <p class="text-sm text-gray-600">
      Скасоване замовлення не враховується у виручці та зарплаті механіків.
    </p>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Причина скасування</label>
      <%= text_area_tag :reason, params[:reason], rows: 3, required: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <%# A booking the client is still planning around (D64). Ticked by default;
        the reason above is internal and is not part of the message. %>
    <% if booked && Telegram::Notifier.available_for?(@order.client) %>
      <div>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= hidden_field_tag :notify_telegram, "0", id: nil %>
          <%= check_box_tag :notify_telegram, "1", params.fetch(:notify_telegram, "1") == "1" %>
          Повідомити клієнта в Telegram
        </label>
        <p class="mt-1 text-xs text-gray-500">Клієнт отримає повідомлення, що запис скасовано, з кнопкою записатися на інший час. Причину скасування він не побачить.</p>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer">Закрити</button>
    <button type="submit" class="rounded-md bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 cursor-pointer"><%= booked ? "Скасувати запис" : "Скасувати замовлення" %></button>
  </div>
<% end %>
