<%= render "shared/modal_header", title: "Додати велосипед" %>

<%= form_with model: [ @client, @bike ], class: "contents", data: { turbo_frame: "_top" } do |f| %>
  <div class="p-6 space-y-4">
    <% if @bike.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @bike.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <span class="block text-sm font-medium text-gray-700 mb-1">Клієнт</span>
      <p class="rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-600">
        <%= @client.name %> · <%= @client.formatted_phone %>
      </p>
    </div>

    <div>
      <%= f.label :name, "Назва велосипеда", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, autofocus: true, placeholder: "Trek Marlin 7, чорний",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :brand, "Бренд", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :brand, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :model, "Модель", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :model, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :color, "Колір", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :color, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :size, "Розмір", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :size, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit t("actions.save"), class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
