<% content_for :title, @bike.display_name %>

<div class="mb-4">
  <%= link_to "← До велосипедів", bikes_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="bg-white border border-gray-200 rounded-xl p-5 mb-6 flex flex-col sm:flex-row sm:items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @bike.name %></h1>
    <p class="text-gray-500 text-sm mt-1">
      <%= link_to @bike.client.name, @bike.client, class: "hover:underline" %> ·
      <%= render "shared/phone_actions", phone: @bike.client.phone %>
    </p>
  </div>
  <% if @bike.active? %>
    <span class="shrink-0 self-start inline-block rounded-full px-2.5 py-1 text-xs font-medium <%= @bike.in_shop? ? "bg-amber-100 text-amber-700" : "bg-gray-100 text-gray-600" %>">
      <%= @bike.in_shop? ? "У майстерні" : "Видано" %>
    </span>
  <% else %>
    <span class="shrink-0 self-start inline-block rounded-full px-2.5 py-1 text-xs font-medium bg-red-100 text-red-700">Архівовано</span>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="bg-white border border-gray-200 rounded-xl p-5 space-y-4">
    <% [ [ "Бренд", @bike.brand ], [ "Модель", @bike.model ],
         [ "Колір", @bike.color ], [ "Розмір", @bike.size ] ].each do |label, value| %>
      <div>
        <p class="text-xs text-gray-500"><%= label %></p>
        <p class="text-sm text-gray-900"><%= value.presence || "—" %></p>
      </div>
    <% end %>
    <div>
      <p class="text-xs text-gray-500">Примітки</p>
      <p class="text-sm text-gray-900 whitespace-pre-line"><%= @bike.notes.presence || "—" %></p>
    </div>

    <%# The bike's own photos (deletable here) first, then the intake photos
        from its orders — read-only, they belong to the visit they record. %>
    <% order_photos = @orders.flat_map(&:photos) %>
    <div data-controller="lightbox">
      <p class="text-xs text-gray-500 mb-1">Фото</p>
      <% if @bike.photos.attached? || order_photos.any? %>
        <div class="grid grid-cols-3 gap-2 mb-2">
          <% @bike.photos.each do |photo| %>
            <div class="relative">
              <%= image_tag photo.variant(resize_to_limit: [ 150, 150 ]),
                    data: { action: "click->lightbox#open",
                            full_src: url_for(photo.variant(resize_to_limit: [ 1600, 1600 ])),
                            full_alt: @bike.name },
                    class: "rounded-md border border-gray-200 aspect-square object-cover w-full cursor-zoom-in" %>
              <%= button_to "×", bike_photo_path(@bike, photo), method: :delete,
                    data: { turbo_confirm: "Видалити фото?" },
                    class: "absolute top-1 right-1 w-5 h-5 rounded-full bg-gray-900/70 text-white text-xs leading-none cursor-pointer" %>
            </div>
          <% end %>
          <% order_photos.each do |photo| %>
            <%= image_tag photo.variant(resize_to_limit: [ 150, 150 ]),
                  title: "З прийому в ремонт",
                  data: { action: "click->lightbox#open",
                          full_src: url_for(photo.variant(resize_to_limit: [ 1600, 1600 ])),
                          full_alt: @bike.name },
                  class: "rounded-md border border-gray-200 aspect-square object-cover w-full cursor-zoom-in" %>
          <% end %>
        </div>
      <% end %>
      <%= form_with url: bike_photos_path(@bike), multipart: true, class: "flex items-center gap-2" do %>
        <%= file_field_tag "photos[]", multiple: true, accept: "image/*",
              class: "block w-full text-xs text-gray-700 file:mr-2 file:rounded-md file:border-0 file:bg-gray-100 file:px-2 file:py-1 file:text-xs file:font-medium hover:file:bg-gray-200" %>
        <%= submit_tag "Додати", class: "shrink-0 rounded-md border border-gray-300 text-xs font-medium px-3 py-1.5 hover:bg-gray-50 cursor-pointer" %>
      <% end %>

      <dialog data-lightbox-target="dialog" data-action="click->lightbox#closeOnBackdrop"
              class="max-w-[90vw] max-h-[90vh] rounded-xl p-0 m-auto bg-transparent backdrop:bg-gray-900/80">
        <img data-lightbox-target="image" class="max-w-[90vw] max-h-[90vh] rounded-xl object-contain" alt="">
        <button type="button" data-action="lightbox#close" aria-label="Закрити"
                class="absolute top-2 right-2 w-8 h-8 rounded-full bg-gray-900/70 text-white text-lg leading-none cursor-pointer">&times;</button>
      </dialog>
    </div>
  </div>

  <div class="lg:col-span-2">
    <h2 class="font-bold text-gray-900 mb-3">Історія замовлень</h2>
    <% if @orders.any? %>
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden sm:overflow-x-auto">
        <table class="data-table w-full text-sm">
          <thead class="bg-gray-50 text-left text-gray-500">
            <tr>
              <th class="px-4 py-3 font-medium">№</th>
              <th class="px-4 py-3 font-medium">Дата</th>
              <th class="px-4 py-3 font-medium">Механік</th>
              <th class="px-4 py-3 font-medium">Статус</th>
              <th class="px-4 py-3 font-medium">Сума</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td data-label="№" data-card="title" class="px-4 py-3">
                  <%= link_to order_number(order), order, class: "card-link font-medium text-brand-600 hover:underline" %>
                </td>
                <td data-label="Дата" data-card="info" class="px-4 py-3 text-gray-600"><%= l order.accepted_at.to_date %></td>
                <td data-label="Механік" data-card="meta" class="px-4 py-3 text-gray-600"><%= order.mechanic&.name || "—" %></td>
                <td data-label="Статус" data-card="badge" class="px-4 py-3"><%= render "shared/status_badge", order: order %></td>
                <td data-label="Сума" data-card="amount" class="px-4 py-3 text-gray-600"><%= money(order.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-400">
        Цей велосипед ще не був у роботі.
      </div>
    <% end %>
  </div>
</div>
