<% content_for :title, t("nav.bikes") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.bikes") %></h1>

<%= filter_frame "bikes_list" do %>
  <div class="mb-6">
    <%= form_with url: bikes_path, method: :get, data: { turbo_frame: "bikes_list" }, class: "max-w-md" do %>
      <%= search_field_tag :q, params[:q], placeholder: "Пошук за назвою або клієнтом…",
            class: "w-full rounded-md border border-gray-200 px-3 py-2 text-sm focus:outline-brand-600" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-gray-500">
          <tr>
            <th class="px-4 py-3 font-medium">Велосипед</th>
          <th class="px-4 py-3 font-medium">Стан</th>
            <th class="px-4 py-3 font-medium">Клієнт</th>
            <th class="px-4 py-3 font-medium">Бренд / модель</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody id="bikes_rows" class="divide-y divide-gray-100">
          <%= render "rows", bikes: @bikes, in_shop_ids: @in_shop_ids %>
        </tbody>
      </table>
    </div>

    <div id="bike_form" class="bg-white border border-gray-200 rounded-xl p-5">
      <%= render "form" %>
    </div>
  </div>
<% end %>
