<%# locals: (bikes:, in_shop_ids: nil) %>
<% bikes.each do |bike| %>
  <tr class="hover:bg-gray-50" id="bike_row_<%= bike.id %>">
    <td data-label="Велосипед" class="px-4 py-3">
      <%= link_to bike.name, bike, class: "font-medium text-gray-900 hover:text-brand-600" %>
    </td>
    <td data-label="Стан" class="px-4 py-3">
      <% in_shop = in_shop_ids ? in_shop_ids.include?(bike.id) : bike.in_shop? %>
      <span class="inline-block rounded-full px-2.5 py-1 text-xs font-medium <%= in_shop ? "bg-amber-100 text-amber-700" : "bg-gray-100 text-gray-600" %>">
        <%= in_shop ? "У майстерні" : "Видано" %>
      </span>
    </td>
    <td data-label="Клієнт" class="px-4 py-3 text-gray-600"><%= link_to bike.client.name, bike.client, class: "hover:underline" %></td>
    <td data-label="Бренд / модель" class="px-4 py-3 text-gray-600"><%= [ bike.brand, bike.model ].compact_blank.join(" ").presence || "—" %></td>
    <td data-label="" class="px-4 py-3 text-right whitespace-nowrap">
      <%= link_to bikes_path(edit: bike.id, q: params[:q]),
            title: t("actions.edit"), "aria-label": t("actions.edit"),
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-brand-600 hover:bg-gray-100 mr-1" do %>
        <%= render "shared/icon", name: :edit %>
      <% end %>
      <%= button_to bike_path(bike, q: params[:q]), method: :delete,
            title: t("actions.archive"), "aria-label": t("actions.archive"), form_class: "inline-block",
            data: { turbo_confirm: "Архівувати велосипед «#{bike.name}»?" },
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-red-600 hover:bg-gray-100 bg-transparent cursor-pointer" do %>
        <%= render "shared/icon", name: :archive %>
      <% end %>
    </td>
  </tr>
<% end %>

<% if bikes.none? %>
  <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">Велосипедів не знайдено</td></tr>
<% end %>
