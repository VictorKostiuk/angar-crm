<% if @bike %>
  <h2 class="font-bold text-gray-900 mb-4">Редагувати велосипед</h2>

  <%= form_with model: @bike, url: bike_path(@bike, q: params[:q]), class: "space-y-4" do |f| %>
    <% if @bike.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @bike.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <span class="block text-sm font-medium text-gray-700 mb-1">Клієнт</span>
      <p class="rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-600">
        <%= link_to @bike.client.name, @bike.client, class: "hover:underline" %> · <%= @bike.client.formatted_phone %>
      </p>
    </div>

    <div>
      <%= f.label :name, "Назва велосипеда", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :brand, "Бренд", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :brand, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :model, "Модель", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :model, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :color, "Колір", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :color, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :size, "Розмір", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :size, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
    </div>

    <div>
      <%= f.label :notes, "Примітки", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notes, rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= link_to t("actions.cancel"), bikes_path(q: params[:q]),
            class: "flex-1 text-center rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
      <%= f.submit t("actions.save"), class: "flex-1 rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
    </div>
  <% end %>
<% else %>
  <h2 class="font-bold text-gray-900 mb-2">Редагувати велосипед</h2>
  <p class="text-sm text-gray-400">Оберіть велосипед зі списку, щоб редагувати. Новий велосипед додається з картки клієнта.</p>
<% end %>
