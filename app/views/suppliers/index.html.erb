<% content_for :title, t("nav.suppliers") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.suppliers") %></h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Назва</th>
          <th class="px-4 py-3 font-medium">Телефон</th>
          <th class="px-4 py-3 font-medium">Email</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody id="suppliers_rows" class="divide-y divide-gray-100">
        <%= render "rows", suppliers: @suppliers %>
      </tbody>
    </table>
  </div>

  <div id="supplier_form" class="bg-white border border-gray-200 rounded-xl p-5">
    <%= render "form" %>
  </div>
</div>
