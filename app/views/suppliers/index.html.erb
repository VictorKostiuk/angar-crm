<% content_for :title, t("nav.suppliers") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.suppliers") %></h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Назва</th>
          <th class="px-4 py-3 font-medium">Телефон</th>
          <th class="px-4 py-3 font-medium">Email</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @suppliers.each do |supplier| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-900"><%= supplier.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= supplier.phone.presence || "—" %></td>
            <td class="px-4 py-3 text-gray-600"><%= supplier.email.presence || "—" %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to t("actions.edit"), suppliers_path(edit: supplier.id), class: "text-gray-400 hover:text-brand-600 mr-3" %>
              <%= button_to t("actions.archive"), supplier_path(supplier), method: :delete,
                    data: { turbo_confirm: "Архівувати постачальника «#{supplier.name}»?" },
                    class: "text-gray-400 hover:text-red-600 bg-transparent inline cursor-pointer" %>
            </td>
          </tr>
        <% end %>

        <% if @suppliers.none? %>
          <tr><td colspan="4" class="px-4 py-10 text-center text-gray-400">Постачальників ще немає</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-5">
    <%= render "form" %>
  </div>
</div>
