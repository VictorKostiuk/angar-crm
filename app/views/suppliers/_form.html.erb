<h2 class="font-bold text-gray-900 mb-4"><%= @supplier.persisted? ? "Редагувати постачальника" : "Додати постачальника" %></h2>

<%= form_with model: @supplier, url: (@supplier.persisted? ? supplier_path(@supplier) : suppliers_path), class: "space-y-4" do |f| %>
  <% if @supplier.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
      <% @supplier.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Назва", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :phone, "Телефон", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :phone, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :notes, "Примітки", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div class="flex gap-2 pt-2">
    <% if @supplier.persisted? %>
      <%= link_to t("actions.cancel"), suppliers_path,
            class: "flex-1 text-center rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
    <% end %>
    <%= f.submit t("actions.save"), class: "flex-1 rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
