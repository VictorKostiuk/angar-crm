<%= render "shared/modal_header", title: "Новий продаж" %>

<%= form_with model: @sale, url: sales_path, class: "contents", data: { turbo_frame: "_top" } do |f| %>
  <div class="p-6 space-y-4 max-h-[70vh] scroll-always">
    <% if @sale.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @sale.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :sold_by_id, "Хто продав", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :sold_by_id, @sellers, :id, :name, {},
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :client_id, "Клієнт (необов'язково)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :client_id, @clients, :id, :name, { include_blank: "Без клієнта" },
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div data-controller="sale-items">
      <p class="block text-sm font-medium text-gray-700">Позиції</p>
      <p class="text-xs text-gray-500 mb-2">Зі складу або своя позиція — тоді вкажіть назву й ціну.</p>
      <div data-sale-items-target="rows" class="space-y-2">
        <%= f.fields_for :sale_items do |item| %>
          <%= render "sales/item_fields", item: item, parts: @parts %>
        <% end %>
      </div>
      <template data-sale-items-target="template">
        <%= f.fields_for :sale_items, SaleItem.new, child_index: "NEW_RECORD" do |item| %>
          <%= render "sales/item_fields", item: item, parts: @parts %>
        <% end %>
      </template>
      <button type="button" data-action="sale-items#add"
              class="mt-2 w-full rounded-md border border-gray-300 text-sm font-medium px-3 py-2 hover:bg-gray-50 cursor-pointer">
        + Ще позиція
      </button>
    </div>

    <div>
      <%= f.label :note, "Примітка (необов'язково)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :note, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit "Записати продаж", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
