<% content_for :title, t("nav.sales") %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("nav.sales") %></h1>
  <%= link_to "+ Новий продаж", new_sale_path, data: { turbo_frame: "modal" },
        class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
</div>

<%= filter_frame "sales_content" do %>
  <div class="bg-white border border-gray-200 rounded-xl p-4 mb-6">
    <%= render "shared/period_filter", path: sales_path, period: @period.period,
          from: @period.from.to_date, to: @period.to.to_date, frame: "sales_content" %>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-sm text-gray-500">Продажі за період</p>
      <p class="text-xl font-bold text-gray-900"><%= money(@total) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-sm text-gray-500">Кількість</p>
      <p class="text-xl font-bold text-gray-900"><%= @sales.size %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-sm text-gray-500">Комісія продавцям</p>
      <p class="text-xl font-bold text-gray-900"><%= money(@commission_total) %></p>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden sm:overflow-x-auto">
    <table class="data-table w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Дата</th>
          <th class="px-4 py-3 font-medium">Позиції</th>
          <th class="px-4 py-3 font-medium">Клієнт</th>
          <th class="px-4 py-3 font-medium">Продав</th>
          <th class="px-4 py-3 font-medium text-right">Сума</th>
          <th class="px-4 py-3 font-medium text-right">Комісія</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @sales.each do |sale| %>
          <tr class="hover:bg-gray-50">
            <td data-label="Дата" data-card="badge" class="px-4 py-3 text-gray-500"><%= l sale.sold_at.to_date %></td>
            <%# A ten-line sale used to print as one wrapping paragraph that swallowed
                the row. Collapsed to the first position plus a count, expandable in
                place — <details> does it natively, no controller and no state to keep. %>
            <td data-label="Позиції" data-card="title" class="px-4 py-3 text-gray-900">
              <% items = sale.sale_items %>
              <% if items.size > 1 %>
                <details class="group">
                  <summary class="flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-gray-700 hover:text-brand-600">
                    <svg class="w-3.5 h-3.5 shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 6l6 6-6 6" />
                    </svg>
                    <span><%= items.first.name %> <span class="text-gray-400">+ ще <%= items.size - 1 %></span></span>
                  </summary>
                  <ul class="mt-1.5 ml-5 list-disc space-y-0.5 text-xs text-gray-600">
                    <% items.each do |item| %>
                      <li><%= item.name %> × <%= item.quantity %></li>
                    <% end %>
                  </ul>
                </details>
              <% else %>
                <%= items.map { |i| "#{i.name} × #{i.quantity}" }.join(", ") %>
              <% end %>
              <% if sale.note.present? %>
                <span class="block text-xs text-gray-400"><%= sale.note %></span>
              <% end %>
            </td>
            <td data-label="Клієнт" data-card="meta" class="px-4 py-3 text-gray-600"><%= sale.client&.name || "—" %></td>
            <td data-label="Продав" data-card="meta" class="px-4 py-3 text-gray-600"><%= sale.sold_by.name %></td>
            <td data-label="Сума" data-card="amount" class="px-4 py-3 text-right font-medium text-gray-900"><%= money(sale.total) %></td>
            <td data-label="Комісія" data-card="meta" class="px-4 py-3 text-right text-gray-600"><%= money(sale.commission) %></td>
          </tr>
        <% end %>

        <% if @sales.none? %>
          <tr><td colspan="6" class="px-4 py-10 text-center text-gray-400">Продажів за цей період немає</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
