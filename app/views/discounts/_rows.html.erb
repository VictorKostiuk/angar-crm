<%# locals: (discounts:) %>
<% discounts.each do |discount| %>
  <tr class="hover:bg-gray-50" id="discount_row_<%= discount.id %>">
    <td data-label="Назва" class="px-4 py-3 text-gray-900"><%= discount.name %></td>
    <td data-label="Тип" class="px-4 py-3 text-gray-600"><%= t("statuses.discount.#{discount.kind}") %></td>
    <td data-label="Розмір" class="px-4 py-3 text-gray-600"><%= discount.percentage? ? "#{discount.value.to_i}%" : money(discount.value) %></td>
    <td data-label="" class="px-4 py-3 text-right whitespace-nowrap">
      <%= link_to discounts_path(edit: discount.id),
            title: t("actions.edit"), "aria-label": t("actions.edit"),
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-brand-600 hover:bg-gray-100 mr-1" do %>
        <%= render "shared/icon", name: :edit %>
      <% end %>
      <%= button_to discount_path(discount), method: :delete,
            title: t("actions.archive"), "aria-label": t("actions.archive"), form_class: "inline-block",
            data: { turbo_confirm: "Архівувати знижку «#{discount.name}»?" },
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-red-600 hover:bg-gray-100 bg-transparent cursor-pointer" do %>
        <%= render "shared/icon", name: :archive %>
      <% end %>
    </td>
  </tr>
<% end %>

<% if discounts.none? %>
  <tr><td colspan="4" class="px-4 py-10 text-center text-gray-400">Знижок ще немає</td></tr>
<% end %>
