<h2 class="font-bold text-gray-900 mb-4"><%= @discount.persisted? ? "Редагувати знижку" : "Додати знижку" %></h2>

<%= form_with model: @discount, url: (@discount.persisted? ? discount_path(@discount) : discounts_path), class: "space-y-4" do |f| %>
  <% if @discount.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
      <% @discount.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Назва", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :kind, "Тип", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :kind, Discount.kinds.keys.map { |k| [ t("statuses.discount.#{k}"), k ] }, {},
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :value, "Розмір (% або грн)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :value, step: "0.01", min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div class="flex gap-2 pt-2">
    <% if @discount.persisted? %>
      <%= link_to t("actions.cancel"), discounts_path,
            class: "flex-1 text-center rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
    <% end %>
    <%= f.submit t("actions.save"), class: "flex-1 rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
