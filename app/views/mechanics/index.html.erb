<% content_for :title, t("nav.mechanics") %>

<%= filter_frame "mechanics_content" do %>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("nav.mechanics") %></h1>
    <div class="flex flex-wrap items-center gap-3">
      <% if Current.user.owner? %>
        <%= link_to "+ Додати користувача", users_path,
              class: "shrink-0 rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
      <% end %>
      <%= render "shared/period_filter", path: mechanics_path, period: @period.period,
        from: @period.from.to_date, to: @period.to.to_date, frame: "mechanics_content" %>
    </div>
  </div>

  <div class="space-y-4">
    <% @rows.each do |row| %>
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <h2 class="text-lg font-bold text-gray-900"><%= row.mechanic.name %></h2>
          <%= link_to "Відкрити механіка →", mechanic_path(row.mechanic, period: @period.period, from: params[:from], to: params[:to]),
                class: "rounded-md border border-brand-600 text-brand-700 text-sm font-medium px-3 py-1.5 hover:bg-brand-50" %>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4 text-sm">
          <div>
            <p class="text-gray-500">Прийняв замовлень</p>
            <p class="text-lg font-bold text-gray-900"><%= row.accepted_count %></p>
          </div>
          <div>
            <p class="text-gray-500">Зараз в роботі</p>
            <p class="text-lg font-bold text-gray-900"><%= row.in_progress_count %></p>
          </div>
          <div>
            <p class="text-gray-500">Завершив замовлень</p>
            <p class="text-lg font-bold text-gray-900"><%= row.completed_count %></p>
          </div>
        </div>

        <%# Послуги × % заробітку = Заробіток, all on screen, so the payout can
            be checked rather than taken on faith. Загальна сума is shown for
            context only — it is deliberately NOT the earning base (D33). %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 pt-4 border-t border-gray-100 text-sm">
          <div>
            <p class="text-gray-500">Послуги</p>
            <p class="text-lg font-bold text-gray-900"><%= money(row.works_total) %></p>
          </div>
          <div>
            <p class="text-gray-500">Запчастини</p>
            <p class="text-lg font-bold text-gray-900"><%= money(row.parts_total) %></p>
          </div>
          <div>
            <p class="text-gray-500">Загальна сума</p>
            <p class="text-lg font-bold text-gray-900"><%= money(row.total) %></p>
          </div>
          <div>
            <p class="text-gray-500">% заробітку</p>
            <p class="text-lg font-bold text-gray-900"><%= row.mechanic.payroll_percent.to_i %>%</p>
          </div>
          <div>
            <p class="text-gray-500">Заробіток з послуг</p>
            <p class="text-lg font-bold text-green-700"><%= row.payout.positive? ? money(row.payout) : "—" %></p>
            <p class="text-xs text-gray-400"><%= row.mechanic.payroll_percent.to_i %>% від послуг</p>
          </div>
        </div>

        <%# Counter sales are a second earning line with its own rate (D40), so
            they get their own row rather than being mixed into the послуги
            chain above — and the row stays hidden until the shop actually
            pays commission. %>
        <% if row.sells? %>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-gray-100 text-sm">
            <div>
              <p class="text-gray-500">Продажі</p>
              <p class="text-lg font-bold text-gray-900"><%= money(row.sales_total) %></p>
            </div>
            <div>
              <p class="text-gray-500">% з продажу</p>
              <p class="text-lg font-bold text-gray-900"><%= row.mechanic.sales_percent.to_i %>%</p>
            </div>
            <div>
              <p class="text-gray-500">Комісія з продажів</p>
              <p class="text-lg font-bold text-green-700"><%= row.sales_commission.positive? ? money(row.sales_commission) : "—" %></p>
            </div>
            <div>
              <p class="text-gray-500">Всього зароблено</p>
              <p class="text-lg font-bold text-green-700"><%= row.earnings.positive? ? money(row.earnings) : "—" %></p>
              <p class="text-xs text-gray-400">послуги + комісія</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @rows.empty? %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-400">
        Механіків ще немає.
      </div>
    <% end %>
  </div>
<% end %>
