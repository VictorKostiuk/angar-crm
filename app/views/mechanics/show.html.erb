<% content_for :title, @mechanic.name %>

<div class="flex items-center justify-between mb-4">
  <%= link_to "← Назад до механіків", mechanics_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <%= render "shared/period_filter", path: mechanic_path(@mechanic), period: @period.period, from: @period.from.to_date, to: @period.to.to_date %>
</div>

<div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= @mechanic.name %></h1>
  <p class="text-gray-500 text-sm mt-1"><%= t("roles.#{@mechanic.role}") %></p>
  <div class="mt-2 space-y-0.5 text-sm text-gray-600">
    <p><%= @mechanic.email_address %></p>
    <p><%= @mechanic.phone.presence || "—" %></p>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
  <div class="bg-white border border-gray-200 rounded-xl p-4">
    <p class="text-sm text-gray-500">Послуги</p>
    <p class="text-xl font-bold text-gray-900"><%= money(@row.works_total) %></p>
    <p class="mt-1 text-xs text-gray-400">база для заробітку</p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-4">
    <p class="text-sm text-gray-500">Загальна сума</p>
    <p class="text-xl font-bold text-gray-900"><%= money(@row.total) %></p>
    <p class="mt-1 text-xs text-gray-400">із запчастинами <%= money(@row.parts_total) %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-4">
    <p class="text-sm text-gray-500">Завершено замовлень</p>
    <p class="text-xl font-bold text-gray-900"><%= @row.completed_count %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-4">
    <p class="text-sm text-gray-500">В роботі зараз</p>
    <p class="text-xl font-bold text-gray-900"><%= @row.in_progress_count %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-4">
    <p class="text-sm text-gray-500">Заробіток</p>
    <p class="text-xl font-bold text-green-700"><%= @row.payout.positive? ? money(@row.payout) : "—" %></p>
    <p class="mt-1 text-xs text-gray-400"><%= @mechanic.payroll_percent.to_i %>% від послуг</p>
  </div>
</div>

<% if Current.user.owner? %>
  <div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-bold text-gray-900">Виплати</h2>
      <%= link_to "Записати виплату", new_mechanic_payroll_payout_path(@mechanic, month: @period.from.to_date), data: { turbo_frame: "modal" },
            class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-3 py-1.5" %>
    </div>

    <% if @debt %>
      <p class="text-sm text-gray-500 mb-2">
        Борг за весь час:
        <span class="font-bold <%= @debt.owed? ? "text-red-600" : "text-gray-900" %>"><%= money(@debt.balance) %></span>
        <span class="text-gray-400">(зароблено <%= money(@debt.earned) %>, виплачено <%= money(@debt.paid) %>)</span>
      </p>
    <% end %>

    <% if @outstanding %>
      <p class="text-sm text-gray-500 mb-4">
        Залишок до виплати за <%= @period.from.strftime("%m.%Y") %>:
        <span class="font-bold <%= @outstanding.positive? ? "text-green-700" : "text-gray-900" %>"><%= money(@outstanding) %></span>
      </p>
    <% end %>

    <% if @payouts.any? %>
      <div class="divide-y divide-gray-100 text-sm">
        <% @payouts.each do |payout| %>
          <div class="flex items-center justify-between gap-3 py-2">
            <span class="text-gray-900"><%= l payout.paid_on %></span>
            <span class="font-medium text-gray-900"><%= money(payout.amount) %></span>
            <span class="text-gray-500">за <%= payout.period_month.strftime("%m.%Y") %></span>
            <span class="text-gray-500"><%= payout.recorded_by.name %></span>
            <span class="text-gray-400"><%= payout.note %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">Виплат ще не було.</p>
    <% end %>
  </div>
<% end %>

<div class="mb-6">
  <h2 class="font-bold text-gray-900 mb-3">Зараз в роботі</h2>
  <% if @open_orders.any? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <% @open_orders.each do |order| %>
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 last:border-0 text-sm">
          <span class="font-medium text-brand-600"><%= link_to order_number(order), order %></span>
          <span class="text-gray-900"><%= order.bike.name %></span>
          <span class="text-gray-600"><%= order.client.name %></span>
          <%= render "shared/status_badge", order: order %>
          <%= link_to "Відкрити замовлення →", order, class: "text-gray-400 hover:text-brand-600" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-400">Немає замовлень у роботі.</p>
  <% end %>
</div>

<div>
  <h2 class="font-bold text-gray-900 mb-3">Завершені замовлення</h2>
  <% if @closed_orders.any? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <% @closed_orders.each do |order| %>
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 last:border-0 text-sm">
          <span class="font-medium text-brand-600"><%= link_to order_number(order), order %></span>
          <span class="text-gray-900"><%= order.bike.name %></span>
          <span class="text-gray-500"><%= order.closed_at.strftime("%d.%m") %></span>
          <span class="text-gray-600">Послуги: <%= money(@works_by_order[order.id] || 0) %></span>
          <span class="font-medium text-gray-900">Разом: <%= money(order.total) %></span>
          <%= link_to "Відкрити замовлення →", order, class: "text-gray-400 hover:text-brand-600" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-400">Немає завершених замовлень у цьому періоді.</p>
  <% end %>
</div>
