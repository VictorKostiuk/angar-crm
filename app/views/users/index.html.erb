<% content_for :title, t("nav.settings") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Користувачі</h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Ім'я</th>
          <th class="px-4 py-3 font-medium">Email</th>
          <th class="px-4 py-3 font-medium">Роль</th>
          <th class="px-4 py-3 font-medium">% ЗП</th>
          <th class="px-4 py-3 font-medium">Статус</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-900"><%= user.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= user.email_address %></td>
            <td class="px-4 py-3 text-gray-600"><%= t("roles.#{user.role}") %></td>
            <td class="px-4 py-3 text-gray-600"><%= user.mechanic? ? "#{user.payroll_percent.to_i}%" : "—" %></td>
            <td class="px-4 py-3">
              <span class="inline-block rounded-full px-2.5 py-1 text-xs font-medium <%= user.active? ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500" %>">
                <%= user.active? ? "Активний" : "Деактивований" %>
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("actions.edit"), users_path(edit: user.id), class: "text-gray-400 hover:text-brand-600" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-5">
    <%= render "form" %>
  </div>
</div>
