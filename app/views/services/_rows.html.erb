<%# locals: (services:, category_id:) %>
<% services.each do |service| %>
  <tr class="hover:bg-gray-50" id="service_row_<%= service.id %>">
    <td data-label="Назва послуги" data-card="title" class="px-4 py-3 text-gray-900"><%= service.name %></td>
    <td data-label="Категорія" data-card="info" class="px-4 py-3 text-gray-600"><%= service.category.name %></td>
    <td data-label="Ціна" data-card="amount" class="px-4 py-3 text-gray-600"><%= money(service.base_price) %></td>
    <td data-label="" data-card="actions" class="px-4 py-3 text-right whitespace-nowrap">
      <%= link_to services_path(edit: service.id, category_id: category_id),
            title: t("actions.edit"), "aria-label": t("actions.edit"),
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-brand-600 hover:bg-gray-100 mr-1" do %>
        <%= render "shared/icon", name: :edit %>
      <% end %>
      <%= button_to service_path(service, category_id: category_id), method: :delete,
            title: t("actions.archive"), "aria-label": t("actions.archive"), form_class: "inline-block",
            data: { turbo_confirm: "Архівувати послугу «#{service.name}»?" },
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-red-600 hover:bg-gray-100 bg-transparent cursor-pointer" do %>
        <%= render "shared/icon", name: :archive %>
      <% end %>
    </td>
  </tr>
<% end %>

<% if services.none? %>
  <tr><td colspan="4" class="px-4 py-10 text-center text-gray-400">Немає послуг у цій категорії</td></tr>
<% end %>
