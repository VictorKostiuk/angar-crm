<div class="min-h-screen w-full flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <% if alert = flash[:alert] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 text-sm font-medium rounded-lg" id="alert"><%= alert %></p>
      <% end %>

      <h1 class="font-bold text-xl text-gray-900 mb-4">Відновлення пароля</h1>

      <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email_address, t("session.email_address"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block w-full rounded-md border border-gray-300 focus:outline-brand-600 px-3 py-2" %>
        </div>

        <%= form.submit "Надіслати інструкції", class: "w-full text-center rounded-md px-3.5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-medium cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
