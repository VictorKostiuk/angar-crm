<% content_for :title, t("nav.bookings") %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("nav.bookings") %></h1>
  <div class="flex flex-wrap items-center gap-2">
    <% if Current.user.admin? || Current.user.owner? %>
      <%= link_to "Налаштування запису", booking_settings_path,
            class: "rounded-md border border-gray-300 text-sm font-medium px-4 py-2 hover:bg-gray-50" %>
    <% end %>
    <%= link_to "+ Записати", new_booking_path,
          class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
  </div>
</div>

<% if WorkingHour.unconfigured? %>
  <div class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 mb-4">
    Робочий тиждень ще не збережено — поки що всі дні вважаються вихідними.
    <% if Current.user.admin? || Current.user.owner? %>
      <%= link_to "Відкрийте налаштування й натисніть «Зберегти розклад»", booking_settings_path, class: "underline" %>.
    <% end %>
  </div>
<% end %>

<% if @types.none? %>
  <div class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 mb-4">
    Ще не налаштовано жодного типу ТО — записувати немає на що.
    <% if Current.user.admin? || Current.user.owner? %>
      <%= link_to "Додати в налаштуваннях", booking_settings_path, class: "underline" %>.
    <% end %>
  </div>
<% end %>

<%= filter_frame "bookings_calendar" do %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl p-3 sm:p-5">
      <div class="flex items-center justify-between mb-4">
        <%= link_to "‹", bookings_path(month: @month.prev_month.strftime("%Y-%m")), data: { turbo_frame: "bookings_calendar" },
              "aria-label": "Попередній місяць", class: "w-9 h-9 flex items-center justify-center rounded-md text-lg text-gray-600 hover:bg-gray-100" %>
        <h2 class="font-bold text-gray-900"><%= t("calendar.month_names")[@month.month] %> <%= @month.year %></h2>
        <%= link_to "›", bookings_path(month: @month.next_month.strftime("%Y-%m")), data: { turbo_frame: "bookings_calendar" },
              "aria-label": "Наступний місяць", class: "w-9 h-9 flex items-center justify-center rounded-md text-lg text-gray-600 hover:bg-gray-100" %>
      </div>

      <div class="grid grid-cols-7 gap-1 text-center text-xs font-medium text-gray-500 mb-1">
        <% %w[ Пн Вт Ср Чт Пт Сб Нд ].each do |name| %>
          <div class="py-1"><%= name %></div>
        <% end %>
      </div>

      <div class="grid grid-cols-7 gap-1">
        <% @days.each do |day| %>
          <% date = day.date %>
          <% count = @counts[date].to_i %>
          <% in_month = date.month == @month.month %>
          <%# A dimmed day from the next or previous month opens that month. %>
          <%= link_to bookings_path(month: date.strftime("%Y-%m"), date: date), data: { turbo_frame: "bookings_calendar" },
                "aria-label": l(date, format: :long),
                class: class_names("min-h-14 sm:min-h-20 rounded-lg border p-1 sm:p-2 text-left flex flex-col justify-between",
                                   date == @date ? "border-brand-600 ring-1 ring-brand-600" : "border-gray-200 hover:border-gray-300",
                                   day.open? ? "bg-white" : "bg-gray-50",
                                   in_month ? "" : "opacity-40") do %>
            <span class="flex items-center justify-between gap-1">
              <span class="<%= class_names("text-sm", date == Date.current ? "font-bold text-brand-700" : "text-gray-900") %>"><%= date.day %></span>
              <% if day.shortened? %>
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500" title="Скорочений день"></span>
              <% end %>
            </span>
            <% if count.positive? %>
              <span class="self-start rounded-full bg-sky-100 text-sky-700 text-[11px] font-medium px-1.5 leading-5"><%= count %></span>
            <% elsif !day.open? %>
              <span class="hidden sm:block text-[10px] text-gray-400 truncate">вихідний</span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-4 mt-3 text-xs text-gray-500">
        <span class="inline-flex items-center gap-1"><span class="rounded-full bg-sky-100 text-sky-700 px-1.5 leading-5">2</span> записів</span>
        <span class="inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> скорочений / особливий день</span>
        <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded border border-gray-300 bg-gray-100"></span> вихідний</span>
      </div>
    </div>

    <div class="space-y-6">
      <%= render "bookings/day", day: @day %>
      <%= render "bookings/upcoming", orders: @upcoming %>
    </div>
  </div>
<% end %>
