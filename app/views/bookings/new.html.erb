<% content_for :title, "Новий запис" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-4">
    <%= link_to "← До календаря", bookings_path(date: @day.date), class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-6">Запис на огляд</h1>

  <% if @order.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 mb-4">
      <% @order.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: bookings_path, class: "space-y-6" do %>
    <%# Same client/bike frame as intake: the client search and «Змінити» both
        load new_order_path into it, and Turbo lifts out just this frame. %>
    <%= turbo_frame_tag "client_and_bike", class: "block space-y-6" do %>
      <%= render "orders/client_and_bike_fields", client: @client, order: @order %>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-xl p-5"
         data-controller="slot-picker" data-slot-picker-url-value="<%= slots_bookings_path %>">
      <h2 class="font-bold text-gray-900 mb-3">3. Що і коли</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <div>
          <label for="maintenance_type_id" class="block text-sm font-medium text-gray-700 mb-1">Тип ТО</label>
          <%= select_tag "maintenance_type_id", options_from_collection_for_select(@types, :id, :label, @type&.id),
                data: { slot_picker_target: "type", action: "change->slot-picker#refresh" },
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Дата</label>
          <%= date_field_tag "date", @day.date, min: Date.current,
                data: { slot_picker_target: "date", action: "change->slot-picker#refresh" },
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
        </div>
      </div>
      <p class="block text-sm font-medium text-gray-700 mb-2">Час</p>
      <div>
        <%= render "bookings/slots", day: @day, type: @type, selected: @selected %>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">4. Telegram (необов'язково)</h2>
      <%= text_field_tag "telegram_username", params[:telegram_username], placeholder: "@нік клієнта",
            autocapitalize: "off", autocomplete: "off",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-xs text-gray-500">Збережеться в картці клієнта. Порожнє поле не стирає вже відомий нік.</p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-bold text-gray-900 mb-3">5. Що турбує (необов'язково)</h2>
      <%= text_area_tag "problem", @order.problem, rows: 3,
            placeholder: "Наприклад: скрипить каретка, підготувати до сезону",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div class="flex flex-wrap justify-end gap-2">
      <%= link_to t("actions.cancel"), bookings_path, class: "rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
      <%= submit_tag "Записати", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-6 py-2 cursor-pointer" %>
    </div>
  <% end %>
</div>
