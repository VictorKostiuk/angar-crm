<%= render "shared/modal_header", title: "Змінити статус" %>

<%= form_with url: order_status_path(@order), method: :patch, class: "contents" do |f| %>
  <div class="p-6 space-y-4">
    <% if @order.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @order.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-2">
      <% Order::OPEN_STATUSES.each do |status| %>
        <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 has-checked:border-brand-600 has-checked:bg-brand-50 cursor-pointer">
          <%= f.radio_button :status, status, checked: @order.status == status, class: "mt-1" %>
          <span>
            <span class="block text-sm font-medium text-gray-900"><%= t("statuses.order.#{status}") %></span>
            <span class="block text-xs text-gray-500"><%= t("statuses.order_descriptions.#{status}") %></span>
          </span>
        </label>
      <% end %>
    </div>

    <div>
      <label for="mechanic_id" class="block text-sm font-medium text-gray-700 mb-1">Механік</label>
      <%= select_tag :mechanic_id,
            options_for_select([ [ "Не призначено", "" ] ] + @mechanics.map { |m| [ m.name, m.id ] }, @order.mechanic_id),
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-xs text-gray-500">Хто виконуватиме роботу.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Коментар до зміни статусу (необов'язково)</label>
      <%= f.text_area :comment, rows: 3, maxlength: 200,
            data: { controller: "char-counter", char_counter_limit_value: 200, action: "input->char-counter#update" },
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-right text-xs text-gray-400" data-char-counter-target="count">0/200</p>
    </div>

    <p class="text-xs text-gray-500">
      Статус «Закрито» доступний лише через функцію «Закрити замовлення» після оплати та видачі велосипеда клієнту.
    </p>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit "Зберегти статус", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
