<%# locals: (expenses:) %>
<% expenses.each do |expense| %>
  <tr class="hover:bg-gray-50" id="expense_row_<%= expense.id %>">
    <td data-label="Дата" class="px-4 py-3 text-gray-600 whitespace-nowrap"><%= expense.date.strftime("%d.%m.%Y") %></td>
    <td data-label="Категорія" class="px-4 py-3 text-gray-900">
      <%= expense.category %>
      <% if expense.auto_logged? %>
        <span class="ml-1 inline-block rounded-full bg-gray-100 text-gray-500 text-xs font-medium px-2 py-0.5">витрачено на замовлення</span>
      <% end %>
    </td>
    <td data-label="Опис" class="px-4 py-3 text-gray-600"><%= expense.description.presence || "—" %></td>
    <td data-label="Сума" class="px-4 py-3 text-gray-900 whitespace-nowrap"><%= money(expense.amount) %></td>
    <td data-label="" class="px-4 py-3 text-right whitespace-nowrap">
      <%= link_to expenses_path(edit: expense.id),
            title: t("actions.edit"), "aria-label": t("actions.edit"),
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-brand-600 hover:bg-gray-100 mr-1" do %>
        <%= render "shared/icon", name: :edit %>
      <% end %>
      <%= button_to expense_path(expense), method: :delete,
            title: t("actions.delete"), "aria-label": t("actions.delete"), form_class: "inline-block",
            data: { turbo_confirm: "Видалити витрату «#{expense.category}»?" },
            class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-400 hover:text-red-600 hover:bg-gray-100 bg-transparent cursor-pointer" do %>
        <%= render "shared/icon", name: :delete %>
      <% end %>
    </td>
  </tr>
<% end %>

<% if expenses.none? %>
  <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">Витрат ще немає</td></tr>
<% end %>
