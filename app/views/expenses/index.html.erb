<% content_for :title, t("nav.finances") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.finances") %></h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden sm:overflow-x-auto">
    <table class="data-table w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Дата</th>
          <th class="px-4 py-3 font-medium">Категорія</th>
          <th class="px-4 py-3 font-medium">Опис</th>
          <th class="px-4 py-3 font-medium">Сума</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody id="expenses_rows" class="divide-y divide-gray-100">
        <%= render "rows", expenses: @expenses %>
      </tbody>
    </table>
  </div>

  <div id="expense_form" class="bg-white border border-gray-200 rounded-xl p-5">
    <%= render "form" %>
  </div>
</div>
