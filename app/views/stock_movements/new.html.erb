<%= render "shared/modal_header", title: "Рух складу — #{@part.name}" %>

<%= form_with model: @movement, url: part_stock_movements_path(@part), class: "contents" do |f| %>
  <div class="p-6 space-y-4">
    <% if @movement.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @movement.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <p class="text-sm text-gray-500">Зараз на складі: <span class="font-medium text-gray-900"><%= @part.stock_quantity %></span></p>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Тип руху</label>
      <div class="space-y-2">
        <% StockMovementsController::ALLOWED_KINDS.each do |kind| %>
          <label class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 has-checked:border-brand-600 has-checked:bg-brand-50 cursor-pointer">
            <%= f.radio_button :kind, kind, checked: @movement.kind == kind %>
            <span class="text-sm text-gray-900"><%= t("statuses.stock_movement.#{kind}") %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <%= f.label :quantity, "Кількість", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :quantity, step: 1, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-xs text-gray-400">Для коригування можна вказати від'ємне число.</p>
    </div>

    <div>
      <%= f.label :note, "Примітка (необов'язково)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :note, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit t("actions.save"), class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
