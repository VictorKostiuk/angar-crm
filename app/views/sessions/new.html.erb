<div class="min-h-screen w-full flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-bold text-2xl text-gray-900"><%= t("app.name") %></h1>
      <p class="text-gray-500 text-sm"><%= t("app.tagline") %></p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <% if alert = flash[:alert] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 text-sm font-medium rounded-lg" id="alert"><%= alert %></p>
      <% end %>

      <% if notice = flash[:notice] %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 text-sm font-medium rounded-lg" id="notice"><%= notice %></p>
      <% end %>

      <%= form_with url: session_url, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email_address, t("session.email_address"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block w-full rounded-md border border-gray-300 focus:outline-brand-600 px-3 py-2" %>
        </div>

        <div>
          <%= form.label :password, t("session.password"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "block w-full rounded-md border border-gray-300 focus:outline-brand-600 px-3 py-2" %>
        </div>

        <%= form.submit t("actions.sign_in"), class: "w-full text-center rounded-md px-3.5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-medium cursor-pointer" %>
      <% end %>

      <div class="mt-4 text-center text-sm text-gray-500">
        <%= link_to "Забули пароль?", new_password_path, class: "text-gray-600 underline hover:no-underline" %>
      </div>
    </div>
  </div>
</div>
