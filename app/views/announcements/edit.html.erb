<% content_for :title, t("nav.settings") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.settings") %></h1>
<%= render "shared/settings_tabs", active: :announcement %>

<div class="max-w-2xl bg-white border border-gray-200 rounded-xl p-5">
  <h2 class="font-bold text-gray-900 mb-1">Рядок оголошень</h2>
  <p class="text-sm text-gray-500 mb-4">
    Текст біжить у правому куті шапки на комп'ютері. Його бачать усі працівники.
  </p>

  <%= form_with model: @announcement, url: announcement_path, method: :patch, class: "space-y-4" do |f| %>
    <% if @announcement.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @announcement.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :text, "Текст", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :text, maxlength: Announcement::MAX_LENGTH, autofocus: true,
            placeholder: "Наприклад: у суботу працюємо до 15:00",
            data: { controller: "char-counter", char_counter_limit_value: Announcement::MAX_LENGTH,
                    action: "input->char-counter#update" },
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-right text-xs text-gray-400" data-char-counter-target="count">0/<%= Announcement::MAX_LENGTH %></p>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :active, class: "rounded border-gray-300" %>
      <%= f.label :active, "Показувати", class: "text-sm text-gray-700" %>
    </div>

    <%# The saved state, not a live preview of the field above — labelled as
        such so it can't be read as "this is what you're about to save". %>
    <div class="rounded-md bg-gray-50 border border-gray-200 p-4">
      <p class="text-xs text-gray-500 mb-2">Зараз у шапці:</p>
      <% if @announcement.visible? %>
        <%= render "shared/announcement_ticker" %>
        <p class="lg:hidden text-xs text-gray-400">Видно лише на комп'ютері.</p>
      <% else %>
        <p class="text-sm text-gray-400">Нічого не показується.</p>
      <% end %>
    </div>

    <%= f.submit t("actions.save"), class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  <% end %>
</div>
