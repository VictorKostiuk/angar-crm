<% content_for :title, @client.name %>

<div class="mb-4">
  <%= link_to "← Назад до клієнтів", clients_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="flex flex-wrap items-start justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @client.name %></h1>
    <p class="text-gray-500 text-sm mt-1"><%= @client.formatted_phone %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "+ Нове замовлення", new_order_path(client_id: @client.id),
          class: "rounded-md bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium px-4 py-2" %>
    <%= link_to "Додати велосипед", new_client_bike_path(@client), data: { turbo_frame: "modal" },
          class: "rounded-md border border-gray-300 text-sm font-medium px-4 py-2 hover:bg-gray-50" %>
    <%= link_to t("actions.edit") + " клієнта", edit_client_path(@client), data: { turbo_frame: "modal" },
          class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
  <div class="md:col-span-2 bg-white border border-gray-200 rounded-xl p-5">
    <h2 class="font-bold text-gray-900 mb-3">Контакти</h2>
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="text-gray-500">Телефон</dt><dd class="text-gray-900"><%= @client.formatted_phone %></dd>
      <dt class="text-gray-500">Email</dt><dd class="text-gray-900"><%= @client.email.presence || "—" %></dd>
      <dt class="text-gray-500">Місто</dt><dd class="text-gray-900"><%= @client.city.presence || "—" %></dd>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-5">
    <h2 class="font-bold text-gray-900 mb-3">Примітки</h2>
    <p class="text-sm text-gray-600 whitespace-pre-line"><%= @client.notes.presence || "—" %></p>
  </div>
</div>

<div class="mb-6">
  <h2 class="font-bold text-gray-900 mb-3">Велосипеди клієнта</h2>
  <div class="flex flex-wrap gap-2">
    <% if @bikes.any? %>
      <%= link_to "Усі", client_path(@client),
            class: class_names("rounded-full border px-3 py-1.5 text-sm",
                                @selected_bike ? "border-gray-200 bg-white text-gray-700 hover:bg-gray-50" : "border-brand-600 bg-brand-600 text-white") %>
      <% @bikes.each do |bike| %>
        <%= link_to bike.display_name, client_path(@client, bike_id: bike.id),
              class: class_names("rounded-full border px-3 py-1.5 text-sm",
                                  @selected_bike == bike ? "border-brand-600 bg-brand-600 text-white" : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50") %>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400">Велосипедів ще немає.</p>
    <% end %>
  </div>
</div>

<div>
  <h2 class="font-bold text-gray-900 mb-3">Історія замовлень</h2>
  <% if @orders.any? %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden sm:overflow-x-auto">
      <table class="data-table w-full text-sm">
        <thead class="bg-gray-50 text-left text-gray-500">
          <tr>
            <th class="px-4 py-3 font-medium">№</th>
            <th class="px-4 py-3 font-medium">Велосипед</th>
            <th class="px-4 py-3 font-medium">Дата</th>
            <th class="px-4 py-3 font-medium">Статус</th>
            <th class="px-4 py-3 font-medium">Сума</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50">
              <td data-label="№" class="px-4 py-3">
                <%= link_to order_number(order), order, class: "font-medium text-brand-600 hover:underline" %>
              </td>
              <td data-label="Велосипед" class="px-4 py-3 text-gray-600"><%= order.bike.name %></td>
              <td data-label="Дата" class="px-4 py-3 text-gray-600"><%= l order.accepted_at.to_date %></td>
              <td data-label="Статус" class="px-4 py-3"><%= render "shared/status_badge", order: order %></td>
              <td data-label="Сума" class="px-4 py-3 text-gray-600"><%= money(order.total) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="bg-gray-50 font-medium text-gray-900">
          <tr>
            <td data-label="№" class="px-4 py-3" colspan="4">
              Разом за <%= @billed_orders.size %> <%= t("orders_count", count: @billed_orders.size) %>
              <% if @billed_orders.size < @orders.size %>
                <span class="font-normal text-gray-400">(скасовані не враховані)</span>
              <% end %>
            </td>
            <td data-label="Велосипед" class="px-4 py-3"><%= money(@orders_total) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-400">
      У цього клієнта ще немає замовлень.
    </div>
  <% end %>
</div>
