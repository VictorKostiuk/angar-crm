<%# locals: (client:) %>
<%= form_with model: client, class: "contents", data: { turbo_frame: "_top" } do |f| %>
  <div class="p-6 space-y-4">
    <% if client.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% client.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, autofocus: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :phone, placeholder: "097 123 45 67", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :telegram_username, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :telegram_username, placeholder: "@нік", autocapitalize: "off", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :city, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :city, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :discount_id, "Постійна знижка", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :discount_id, Discount.active.ordered, :id,
            ->(d) { "#{d.name} — #{t("discount_scopes.#{d.applies_to}")}" }, { include_blank: "Без постійної знижки" },
            data: { controller: "combobox" }, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      <p class="mt-1 text-xs text-gray-500">Застосовується автоматично. Якщо клієнт заробив більшу знижку за обігом — діє більша.</p>
    </div>

    <div>
      <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notes, rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit t("actions.save"), class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
