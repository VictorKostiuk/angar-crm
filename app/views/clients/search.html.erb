<%# Loaded into the intake screen's results frame — Turbo needs the matching
    <turbo-frame> in the response or the navigation fails with "Content missing". %>
<%= turbo_frame_tag "client_search_results" do %>
  <% if @clients.any? %>
    <div class="rounded-md border border-gray-200 divide-y divide-gray-100 overflow-hidden">
      <% @clients.each do |client| %>
        <%= link_to new_order_path(client_id: client.id), data: { turbo_frame: "client_and_bike" },
              class: "block px-3 py-2 hover:bg-gray-50" do %>
          <span class="text-sm text-gray-900"><%= client.name %></span>
          <span class="text-sm text-gray-500 ml-2"><%= client.formatted_phone %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="px-3 py-2 text-sm text-gray-400">Клієнта не знайдено. Створіть нового або введіть дані вручну.</p>
  <% end %>
<% end %>
