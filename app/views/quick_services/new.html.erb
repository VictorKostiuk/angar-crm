<%= render "shared/modal_header", title: "Швидкий сервіс" %>

<%= form_with model: @order, url: quick_services_path, scope: :order, class: "contents", data: { turbo_frame: "_top" } do |f| %>
  <div class="p-6 space-y-4 max-h-[70vh] scroll-always">
    <p class="text-sm text-gray-500">Коротка робота при клієнті: без велосипеда й клієнта. Замовлення одразу закривається як оплачене, а послуги йдуть у зарплату механіка.</p>

    <% if @order.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @order.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :mechanic_id, "Механік", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :mechanic_id, @mechanics, :id, :name, { include_blank: "Оберіть механіка" },
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div data-controller="sale-items">
      <p class="block text-sm font-medium text-gray-700">Послуги</p>
      <p class="text-xs text-gray-500 mb-2">З прайсу або своя — тоді вкажіть назву й ціну.</p>
      <div data-sale-items-target="rows" class="space-y-2">
        <%= f.fields_for :order_works do |work| %>
          <%= render "quick_services/work_fields", work: work, services: @services %>
        <% end %>
      </div>
      <template data-sale-items-target="template">
        <%= f.fields_for :order_works, OrderWork.new, child_index: "NEW_RECORD" do |work| %>
          <%= render "quick_services/work_fields", work: work, services: @services %>
        <% end %>
      </template>
      <button type="button" data-action="sale-items#add"
              class="mt-2 w-full rounded-md border border-gray-300 text-sm font-medium px-3 py-2 hover:bg-gray-50 cursor-pointer">
        + Ще послуга
      </button>
    </div>

    <div data-controller="sale-items">
      <p class="block text-sm font-medium text-gray-700">Матеріали (необов'язково)</p>
      <p class="text-xs text-gray-500 mb-2">Зі складу — спишуться автоматично, або своя позиція.</p>
      <div data-sale-items-target="rows" class="space-y-2">
        <%= f.fields_for :order_parts do |item| %>
          <%= render "sales/item_fields", item: item, parts: @parts %>
        <% end %>
      </div>
      <template data-sale-items-target="template">
        <%= f.fields_for :order_parts, OrderPart.new, child_index: "NEW_RECORD" do |item| %>
          <%= render "sales/item_fields", item: item, parts: @parts %>
        <% end %>
      </template>
      <button type="button" data-action="sale-items#add"
              class="mt-2 w-full rounded-md border border-gray-300 text-sm font-medium px-3 py-2 hover:bg-gray-50 cursor-pointer">
        + Ще матеріал
      </button>
    </div>

    <div>
      <%= f.label :comment, "Примітка (необов'язково)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :comment, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit "Записати", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
