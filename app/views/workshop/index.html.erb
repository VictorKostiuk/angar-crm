<% content_for :title, t("nav.workshop") %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 mb-1"><%= t("nav.workshop") %></h1>
    <p class="text-gray-500 text-sm">Вітаємо, <%= Current.user.name %>.</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%# A five-minute job, entered and closed in one form (D71). %>
    <%= link_to "+ Швидкий сервіс", new_quick_service_path, data: { turbo_frame: "modal" },
          class: "rounded-md border border-brand-600 text-brand-700 text-sm font-medium px-4 py-2 hover:bg-brand-50" %>
    <%= link_to "+ Новий прокат", new_rental_path, data: { turbo_frame: "modal" },
          class: "rounded-md border border-gray-300 text-sm font-medium px-4 py-2 hover:bg-gray-50" %>
    <%= link_to "+ Новий продаж", new_sale_path, data: { turbo_frame: "modal" },
          class: "rounded-md border border-gray-300 text-sm font-medium px-4 py-2 hover:bg-gray-50" %>
    <%= link_to "+ Нове замовлення", new_order_path, class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2" %>
  </div>
</div>


<% dot_colors = {
     "booked" => "bg-sky-500",
     "intake" => "bg-gray-400",
     "waiting_approval" => "bg-amber-500",
     "in_progress" => "bg-blue-500",
     "waiting_parts" => "bg-violet-500",
     "waiting_pickup" => "bg-teal-500"
   } %>

<div data-controller="board-filter">
  <div class="flex flex-wrap gap-2 mb-6">
    <button type="button" data-board-filter-target="pill" data-status="all" data-action="board-filter#filter"
            class="rounded-full px-4 py-1.5 text-sm font-medium bg-brand-600 text-white">Усі</button>
    <% Order::OPEN_STATUSES.each do |status| %>
      <button type="button" data-board-filter-target="pill" data-status="<%= status %>" data-action="board-filter#filter"
              class="rounded-full px-4 py-1.5 text-sm font-medium border border-gray-200 text-gray-700 hover:bg-gray-50"><%= t("statuses.order.#{status}") %></button>
    <% end %>
  </div>

  <div class="space-y-8">
    <% Order::OPEN_STATUSES.each do |status| %>
      <% orders = @orders_by_status[status] %>
      <div data-board-filter-target="section" data-status="<%= status %>">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 rounded-full <%= dot_colors.fetch(status, "bg-gray-400") %>"></span>
          <h2 class="font-bold text-gray-900"><%= t("statuses.order.#{status}") %></h2>
          <span id="board_section_<%= status %>_count" class="text-sm text-gray-400"><%= orders.size %></span>
        </div>

        <div id="board_section_<%= status %>_cards" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          <%= render partial: "workshop/order_card", collection: orders, as: :order %>
        </div>
      </div>
    <% end %>
  </div>
</div>
