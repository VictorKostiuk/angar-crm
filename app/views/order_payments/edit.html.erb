<%= render "shared/modal_header", title: "Оплата" %>

<%= form_with url: order_payment_path(@order), method: :patch, class: "contents" do |f| %>
  <div class="p-6 space-y-4">
    <% if @order.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @order.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="rounded-lg bg-gray-50 p-3">
      <%= render "orders/totals", order: @order %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Спосіб оплати</label>
      <div class="space-y-2">
        <% Order.payment_methods.each_key do |method| %>
          <label class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 has-checked:border-brand-600 has-checked:bg-brand-50 cursor-pointer">
            <%= f.radio_button :payment_method, method, checked: @order.payment_method == method %>
            <span class="text-sm text-gray-900"><%= t("payment_methods.#{method}") %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Номер чека Checkbox</label>
      <%= f.text_field :receipt_number, value: @order.receipt_number,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit "Позначити оплачено", class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
