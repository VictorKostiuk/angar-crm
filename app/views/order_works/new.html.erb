<%= render "shared/modal_header", title: "Додати послугу" %>

<div class="p-6 space-y-4 max-h-[70vh] scroll-always">
  <div>
    <%= render "shared/catalog_search", label: "Пошук послуги",
          placeholder: "Наприклад: ланцюг, гальма, каретка",
          url: search_services_path(order_id: @order.id),
          frame: "order_work_search_results", categories: @categories %>
  </div>

  <%= turbo_frame_tag "order_work_search_results", src: search_services_path(order_id: @order.id),
        class: "block empty:hidden max-h-44 scroll-always divide-y divide-gray-100" %>

  <div class="text-center text-xs text-gray-400">або</div>

  <%= render "custom_form", order: @order, order_work: @order_work %>

  <div class="pt-4 border-t border-gray-100">
    <h3 class="text-sm font-medium text-gray-700 mb-2">Додано до замовлення</h3>
    <table class="data-table w-full text-sm">
      <tbody id="modal_order_work_rows">
        <%= render "orders/order_work_rows", order: @order %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex justify-end px-6 py-4 border-t border-gray-200">
  <button type="button" data-action="dialog#close"
          class="rounded-md bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 cursor-pointer">Готово</button>
</div>
