<% content_for :title, t("nav.parts") %>

<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("nav.parts") %></h1>

<% if params[:low_stock].present? %>
  <div class="flex items-center justify-between mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">
    <span>Показано лише позиції з малим залишком</span>
    <%= link_to "Показати всі", parts_path(category_id: params[:category_id]), class: "underline hover:no-underline" %>
  </div>
<% end %>

<div class="flex flex-wrap gap-2 mb-6">
  <%= link_to "Усі", parts_path,
        class: class_names("rounded-full px-4 py-1.5 text-sm font-medium",
                            @selected_category.nil? ? "bg-brand-600 text-white" : "border border-gray-200 text-gray-700 hover:bg-gray-50") %>
  <% @categories.each do |category| %>
    <%= link_to category.name, parts_path(category_id: category.id),
          class: class_names("rounded-full px-4 py-1.5 text-sm font-medium",
                              @selected_category == category ? "bg-brand-600 text-white" : "border border-gray-200 text-gray-700 hover:bg-gray-50") %>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">Назва позиції</th>
          <th class="px-4 py-3 font-medium">Категорія</th>
          <th class="px-4 py-3 font-medium">Ціна</th>
          <th class="px-4 py-3 font-medium">На складі</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody id="parts_rows" class="divide-y divide-gray-100">
        <%= render "rows", parts: @parts, category_id: params[:category_id] %>
      </tbody>
    </table>
  </div>

  <div id="part_form" class="bg-white border border-gray-200 rounded-xl p-5">
    <%= render "form" %>
  </div>
</div>
