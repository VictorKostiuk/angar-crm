<h2 class="font-bold text-gray-900 mb-4"><%= @part.persisted? ? "Редагувати деталь / матеріал" : "Додати деталь / матеріал" %></h2>

<%= form_with model: @part,
      url: (@part.persisted? ? part_path(@part, category_id: params[:category_id]) : parts_path(category_id: params[:category_id])),
      class: "space-y-4" do |f| %>
  <% if @part.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
      <% @part.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Назва позиції", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :category_id, "Категорія", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :category_id, Category.part.active.ordered, :id, :name, { prompt: "Оберіть категорію" },
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :base_price, "Базова ціна", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="relative">
      <%= f.number_field :base_price, step: 1, min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 pr-12 focus:outline-brand-600" %>
      <span class="absolute right-3 top-2.5 text-gray-400 text-sm pointer-events-none">грн</span>
    </div>
  </div>

  <div>
    <%= f.label :sku, "Артикул", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :sku, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :supplier_id, "Постачальник", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Не вказано" },
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
  </div>

  <div>
    <%= f.label :purchase_price, "Закупівельна ціна", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="relative">
      <%= f.number_field :purchase_price, step: 1, min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 pr-12 focus:outline-brand-600" %>
      <span class="absolute right-3 top-2.5 text-gray-400 text-sm pointer-events-none">грн</span>
    </div>
  </div>

  <div class="flex gap-2 pt-2">
    <% if @part.persisted? %>
      <%= link_to t("actions.cancel"), parts_path(category_id: params[:category_id]),
            class: "flex-1 text-center rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 border border-gray-300" %>
    <% end %>
    <%= f.submit t("actions.save"), class: "flex-1 rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
