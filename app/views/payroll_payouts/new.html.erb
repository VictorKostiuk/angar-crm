<%= render "shared/modal_header", title: "Виплата — #{@mechanic.name}" %>

<%= form_with model: @payout, url: mechanic_payroll_payouts_path(@mechanic), class: "contents", data: { turbo_frame: "_top" } do |f| %>
  <div class="p-6 space-y-4">
    <% if @payout.errors.any? %>
      <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @payout.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%# Two different dates: which month's earnings this settles (month picker —
        only the month is stored) and when the money actually left. %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <%= f.label :period_month, "За який місяць", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.month_field :period_month, value: @payout.period_month&.strftime("%Y-%m"),
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
      <div>
        <%= f.label :paid_on, "Коли виплачено", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :paid_on, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
      </div>
    </div>

    <dl class="rounded-lg bg-gray-50 p-3 space-y-1 text-sm">
      <div class="flex justify-between">
        <dt class="text-gray-500">Нараховано за <%= @month.strftime("%m.%Y") %></dt>
        <dd class="text-gray-900"><%= money(@earned) %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">Уже виплачено</dt>
        <dd class="text-gray-900"><%= money(@already_paid) %></dd>
      </div>
      <div class="flex justify-between pt-1 border-t border-gray-200 font-bold">
        <dt class="text-gray-900">Залишок</dt>
        <dd class="<%= @outstanding.positive? ? "text-green-700" : "text-gray-900" %>"><%= money(@outstanding) %></dd>
      </div>
    </dl>

    <div>
      <%= f.label :amount, "Сума", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :amount, step: 0.01, min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>

    <div>
      <%= f.label :note, "Примітка (необов'язково)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :note, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-200">
    <button type="button" data-action="dialog#close" class="rounded-md px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer"><%= t("actions.cancel") %></button>
    <%= f.submit t("actions.save"), class: "rounded-md bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
  </div>
<% end %>
