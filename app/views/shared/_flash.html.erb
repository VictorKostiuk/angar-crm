<% if (notice = flash[:notice]) %>
  <p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
<% end %>
<% if (alert = flash[:alert]) %>
  <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
<% end %>
