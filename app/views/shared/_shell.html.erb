<div class="min-h-screen flex bg-gray-50" data-controller="sidebar">
  <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="hidden fixed inset-0 z-30 bg-gray-900/50 lg:hidden"></div>

  <aside data-sidebar-target="panel"
         class="fixed inset-y-0 left-0 z-40 w-64 shrink-0 bg-white border-r border-gray-200 flex flex-col -translate-x-full transition-transform duration-200 ease-in-out lg:static lg:translate-x-0">
    <div class="px-5 py-5 border-b border-gray-200 flex items-start justify-between">
      <div>
        <%= render "shared/logo", class: "h-8 w-auto text-brand-600" %>
        <p class="text-xs text-gray-500 leading-tight mt-1"><%= t("app.tagline") %></p>
      </div>
      <button type="button" data-action="sidebar#close" class="lg:hidden p-1 -mr-1 text-gray-400 hover:text-gray-600" aria-label="Закрити меню">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-3 px-2 space-y-0.5">
      <%= render "shared/nav_item", label: t("nav.workshop"), path: root_path, active: current_page?(root_path) %>
      <%= render "shared/nav_item", label: t("nav.orders"), path: orders_path,
            active: request.path.start_with?(orders_path) && params[:status] != "closed" %>
      <%= render "shared/nav_item", label: t("nav.archive"), path: orders_path(status: "closed"),
            active: request.path.start_with?(orders_path) && params[:status] == "closed" %>
      <%= render "shared/nav_item", label: t("nav.clients"), path: clients_path, active: request.path.start_with?(clients_path) %>
      <%= render "shared/nav_item", label: t("nav.bikes"), path: bikes_path, active: request.path.start_with?(bikes_path) %>
      <% if Current.user.admin? || Current.user.owner? %>
        <%= render "shared/nav_item", label: t("nav.services"), path: services_path, active: request.path.start_with?(services_path) %>
        <%= render "shared/nav_item", label: t("nav.parts"), path: parts_path, active: request.path.start_with?(parts_path) %>
        <%= render "shared/nav_item", label: t("nav.suppliers"), path: suppliers_path, active: request.path.start_with?(suppliers_path) %>
        <%= render "shared/nav_item", label: t("nav.finances"), path: finances_path,
              active: request.path.start_with?(finances_path) || request.path.start_with?(expenses_path) %>
      <% else %>
        <%= render "shared/nav_item", label: t("nav.services") %>
        <%= render "shared/nav_item", label: t("nav.parts") %>
        <%= render "shared/nav_item", label: t("nav.suppliers") %>
        <%= render "shared/nav_item", label: t("nav.finances") %>
      <% end %>
      <% if Current.user.owner? || Current.user.mechanic? %>
        <%= render "shared/nav_item", label: t("nav.mechanics"), path: mechanics_path, active: request.path.start_with?(mechanics_path) %>
      <% else %>
        <%= render "shared/nav_item", label: t("nav.mechanics") %>
      <% end %>
      <% if Current.user.admin? || Current.user.owner? %>
        <%= render "shared/nav_item", label: t("nav.reports"), path: reports_path, active: request.path.start_with?(reports_path) %>
      <% else %>
        <%= render "shared/nav_item", label: t("nav.reports") %>
      <% end %>

      <div class="my-2 border-t border-gray-100"></div>

      <% if Current.user.owner? %>
        <%= render "shared/nav_item", label: t("nav.settings"), path: users_path, active: request.path.start_with?(users_path) %>
      <% else %>
        <%= render "shared/nav_item", label: t("nav.settings") %>
      <% end %>
    </nav>

    <div class="px-4 py-4 border-t border-gray-200">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 shrink-0 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-medium text-sm">
          <%= Current.user.name.first %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-900 truncate"><%= Current.user.name %></p>
          <p class="text-xs text-gray-500"><%= t("roles.#{Current.user.role}") %></p>
        </div>
        <%= button_to t("actions.sign_out"), session_path, method: :delete,
              class: "text-gray-400 hover:text-gray-600 text-sm shrink-0 bg-transparent" %>
      </div>
    </div>
  </aside>

  <div class="flex-1 flex flex-col min-w-0">
    <header class="h-16 shrink-0 bg-white border-b border-gray-200 flex items-center gap-3 px-4 lg:px-6">
      <button type="button" data-action="sidebar#open" class="lg:hidden p-2 -ml-2 text-gray-500 hover:text-gray-700" aria-label="Відкрити меню">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <%= form_with url: orders_path, method: :get, class: "flex-1 min-w-0 max-w-md" do %>
        <%= search_field_tag :q, params[:q], placeholder: "#{t('actions.search')} замовлення…",
              class: "w-full rounded-md border border-gray-200 px-3 py-2 text-sm focus:outline-brand-600" %>
      <% end %>
    </header>

    <main class="flex-1 overflow-y-auto p-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </div>

  <turbo-frame id="modal"></turbo-frame>
</div>
