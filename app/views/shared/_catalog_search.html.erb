<%# locals: (label:, placeholder:, url:, frame:, categories:) %>
<%# Search box + category pills sharing one frame-search controller, so a pill
    click keeps whatever is typed and typing keeps the selected pill. %>
<div data-controller="frame-search"
     data-frame-search-url-value="<%= url %>"
     data-frame-search-frame-value="<%= frame %>">
  <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>
  <input type="text" autocomplete="off" placeholder="<%= placeholder %>"
         data-frame-search-target="input"
         data-action="input->frame-search#search"
         class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-brand-600">

  <% if categories.any? %>
    <div class="flex flex-wrap gap-1.5 mt-2">
      <button type="button" data-category-id="" data-frame-search-target="pill" data-action="frame-search#filter"
              class="rounded-full px-3 py-1 text-xs font-medium bg-brand-600 text-white cursor-pointer">Усі</button>
      <% categories.each do |category| %>
        <button type="button" data-category-id="<%= category.id %>" data-frame-search-target="pill" data-action="frame-search#filter"
                class="rounded-full px-3 py-1 text-xs font-medium border border-gray-200 text-gray-700 hover:bg-gray-50 cursor-pointer"><%= category.name %></button>
      <% end %>
    </div>
  <% end %>
</div>
