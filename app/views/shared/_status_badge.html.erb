<%# locals: (order:) %>
<% badge_colors = {
     "booked" => "bg-sky-100 text-sky-700",
     "intake" => "bg-gray-100 text-gray-700",
     "waiting_approval" => "bg-amber-100 text-amber-700",
     "in_progress" => "bg-blue-100 text-blue-700",
     "waiting_parts" => "bg-violet-100 text-violet-700",
     "waiting_pickup" => "bg-teal-100 text-teal-700",
     "closed" => "bg-green-100 text-green-700",
     "cancelled" => "bg-red-100 text-red-700"
   } %>
<span class="inline-block rounded-full px-2.5 py-1 text-xs font-medium <%= badge_colors.fetch(order.status, "bg-gray-100 text-gray-700") %>">
  <%= t("statuses.order.#{order.status}") %>
</span>
