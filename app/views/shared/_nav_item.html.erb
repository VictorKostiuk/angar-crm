<%# locals: (label:, path: nil, active: false) %>
<% if path %>
  <%= link_to path, class: class_names(
        "block rounded-lg px-3 py-2 text-sm font-medium",
        active ? "bg-brand-50 text-brand-700" : "text-gray-700 hover:bg-gray-100"
      ) do %>
    <%= label %>
  <% end %>
<% else %>
  <span class="block rounded-lg px-3 py-2 text-sm font-medium text-gray-300 cursor-not-allowed"><%= label %></span>
<% end %>
