<%# locals: (page:, per_page:, total_count:) %>
<% page = page.to_i %>
<% page = 1 if page < 1 %>
<% total_pages = (total_count.to_f / per_page).ceil %>
<% range_start = total_count.zero? ? 0 : (page - 1) * per_page + 1 %>
<% range_end = [ page * per_page, total_count ].min %>

<div class="flex items-center justify-between mt-4 text-sm text-gray-600">
  <p>Показано <%= range_start %>–<%= range_end %> з <%= total_count %></p>

  <div class="flex items-center gap-1">
    <%= link_to "‹", url_for(request.query_parameters.merge(page: page - 1)),
          class: class_names("w-8 h-8 flex items-center justify-center rounded-md border border-gray-200",
                              page <= 1 ? "text-gray-300 pointer-events-none" : "text-gray-600 hover:bg-gray-50") %>

    <span class="w-8 h-8 flex items-center justify-center rounded-md border border-brand-600 bg-brand-50 text-brand-700 font-medium"><%= page %></span>

    <%= link_to "›", url_for(request.query_parameters.merge(page: page + 1)),
          class: class_names("w-8 h-8 flex items-center justify-center rounded-md border border-gray-200",
                              page >= total_pages ? "text-gray-300 pointer-events-none" : "text-gray-600 hover:bg-gray-50") %>
  </div>
</div>
