<%# locals: (active:) %>
<% tabs = [
  [ "Користувачі", :users, users_path ],
  [ "Знижки", :discounts, discounts_path ],
  [ "Запис", :booking, booking_settings_path ],
  [ "Статистика", :statistics, statistics_path ],
  [ "Оголошення", :announcement, edit_announcement_path ]
] %>
<div class="border-b border-gray-200 mb-6">
  <nav class="-mb-px flex gap-6 overflow-x-auto whitespace-nowrap">
    <% tabs.each do |label, key, path| %>
      <%= link_to label, path,
            class: class_names("px-1 py-3 text-sm font-medium border-b-2",
                                active == key ? "border-brand-600 text-brand-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") %>
    <% end %>
  </nav>
</div>
