# Copy to /opt/angar-crm/production.env with permissions 600.
# Generate independent values with: openssl rand -hex 32
ANGAR_CRM_DATABASE_PASSWORD=replace-with-a-random-password
SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
# Needed only when initializing missing owner accounts. Remove after bootstrap.
SEED_OWNER_PASSWORD=choose-an-initial-owner-password
SEED_VIKTOR_PASSWORD=choose-an-initial-viktor-password
